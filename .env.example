# Server-side only — never exposed to the browser.
# Get a key at https://platform.claude.com → API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the extraction model. Default is claude-sonnet-4-6
# (near-perfect transcription, ~6.5s). claude-haiku-4-5 is faster (~3.5-4.5s)
# but can garble very small print — see "Model choice" in the README.
# EXTRACTION_MODEL=claude-sonnet-4-6
