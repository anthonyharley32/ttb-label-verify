# Server-side only — never exposed to the browser.
# Get a key at https://platform.claude.com → API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: Gemini key — when set, extraction prefers gemini-3.5-flash
# (fast + strong printed-text OCR). Get one free at https://aistudio.google.com
# GEMINI_API_KEY=your-gemini-key-here

# Optional: override the extraction model for the active provider.
# Claude default is claude-haiku-4-5 (~3.5-4.5s); claude-sonnet-4-6 is slower
# (~6.5s) but near-perfect on small print — see "Model choice" in the README.
# EXTRACTION_MODEL=claude-sonnet-4-6
